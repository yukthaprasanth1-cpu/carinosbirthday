<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>For Carino ♡</title>

<style>

@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Kalam:wght@300;400;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap');

:root {
    --cream: #fffaf3;
    --paper: #fffdf9;
    --pink: #f4b6c2;
    --rose: #c96f82;
    --ink: #4b3540;
    --muted: #866d76;
    --line: rgba(190,120,140,.23);
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background: var(--cream);
    color: var(--ink);
    font-family: "Cormorant Garamond", Georgia, serif;
    overflow-x: hidden;
}

.screen {
    min-height: 100vh;
    min-height: 100svh;
    padding: 60px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
}

.hidden {
    display: none !important;
}

.paper {
    width: min(900px, 94vw);
    background: rgba(255,253,249,.95);
    border: 1px solid rgba(190,120,140,.18);
    border-radius: 24px;
    padding: clamp(28px, 6vw, 70px);
    box-shadow: 0 22px 70px rgba(100,50,70,.12);
}

.center {
    text-align: center;
}

h1,
h2,
h3 {
    margin-top: 0;
}

h1 {
    font-family: "Playfair Display", serif;
    font-size: clamp(42px, 8vw, 78px);
    line-height: 1.02;
}

h2 {
    font-family: "Playfair Display", serif;
    font-size: clamp(34px, 6vw, 58px);
    line-height: 1.08;
}

p {
    font-size: clamp(20px, 3.6vw, 26px);
    line-height: 1.8;
}

.small {
    font-size: 18px;
    color: var(--muted);
}

button {
    border: 0;
    cursor: pointer;
    font: 600 18px "Cormorant Garamond", serif;
    color: white;
    background: var(--rose);
    padding: 14px 24px;
    border-radius: 999px;
    box-shadow: 0 10px 24px rgba(160,70,95,.2);
    transition: .25s;
}

button:hover {
    transform: translateY(-2px);
}

button:disabled {
    opacity: .45;
    cursor: not-allowed;
}

.fade {
    animation: fadeUp .9s ease both;
}

@keyframes fadeUp {
    from {
        opacity: 0;
        transform: translateY(18px);
    }

    to {
        opacity: 1;
        transform: none;
    }
}


/* =========================
   LOCK
========================= */

#lock {
    background:
        radial-gradient(
            circle at 50% 25%,
            #ffffff 0,
            #fff7f4 42%,
            #fcecef 100%
        );
}

.lock-heart {
    width: 130px;
    height: 115px;
    margin: 0 auto 25px;
    position: relative;
    transform: rotate(-45deg);
    background: #d98296;
    border-radius: 18px 0 18px 18px;
    box-shadow: 0 18px 35px rgba(180,80,110,.25);
}

.lock-heart:before,
.lock-heart:after {
    content: "";
    position: absolute;
    width: 130px;
    height: 115px;
    background: #d98296;
    border-radius: 50%;
}

.lock-heart:before {
    top: -65px;
    left: 0;
}

.lock-heart:after {
    top: 0;
    left: 65px;
}

.lock-heart span {
    position: absolute;
    z-index: 2;
    transform: rotate(45deg);
    color: white;
    font-size: 50px;
    left: 49px;
    top: 38px;
}

.question {
    margin: 26px 0;
}

input {
    width: min(520px, 100%);
    padding: 16px 18px;
    border: 1px solid rgba(160,90,110,.25);
    border-radius: 14px;
    font: 20px "Cormorant Garamond", serif;
    color: var(--ink);
    background: white;
    outline: none;
}

input:focus {
    border-color: var(--rose);
    box-shadow: 0 0 0 4px rgba(201,111,130,.1);
}

.error {
    color: #b44d68;
    min-height: 26px;
    margin: 12px 0;
    font-size: 18px;
}


/* =========================
   SONGS
========================= */

#songs {
    background: linear-gradient(135deg,#fff8f4,#f9e8ee);
}

.song-list {
    display: grid;
    gap: 16px;
    margin: 32px 0;
}

.song {
    text-align: left;
    background: white;
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 20px;
    display: flex;
    gap: 16px;
    align-items: center;
    cursor: pointer;
    transition: .25s;
}

.song:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(100,50,70,.1);
}

.song .disc {
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background:
        radial-gradient(
            circle,
            #fff 0 10%,
            #e49aac 11% 18%,
            #f4c8d1 19% 45%,
            #d27d91 46%
        );
    flex: 0 0 auto;
}

.song b {
    display: block;
    font-size: 23px;
}

.song span {
    color: var(--muted);
    font-size: 17px;
}


/* =========================
   INTRO
========================= */

#intro {
    background: #fffaf4;
}

.intro-flower {
    font-size: 55px;
    margin-bottom: 18px;
}

.intro-copy {
    max-width: 720px;
    margin: 0 auto 30px;
    text-align: center;
}


/* =========================
   MEMORIES
========================= */

#memories {
    background: #f8e9ec;
}

.mem-grid {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 20px;
    margin-top: 32px;
}

.mem {
    background: white;
    padding: 11px 11px 28px;
    border-radius: 5px;
    box-shadow: 0 12px 30px rgba(80,45,55,.12);
    transform: rotate(-2deg);
}

.mem:nth-child(2) {
    transform: rotate(2deg);
}

.mem:nth-child(3) {
    transform: rotate(-1deg);
}

.mem img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
}

.mem-caption {
    text-align: center;
    font: 18px "Kalam", cursive;
    margin-top: 12px;
}

@media(max-width:700px) {

    .mem-grid {
        grid-template-columns: 1fr;
        max-width: 330px;
        margin-left: auto;
        margin-right: auto;
    }

}


/* =========================
   PUZZLE
========================= */

#puzzle {
    background: linear-gradient(#fffaf7,#f7e9ed);
}

.puzzle-wrap {
    width: min(540px,92vw);
    margin: 30px auto;
}

.puzzle {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    aspect-ratio: 2 / 3;
    gap: 4px;
    padding: 4px;
    background: #f5e5e8;
    border-radius: 18px;
}

.piece {
    border: 0;
    border-radius: 8px;
    background-repeat: no-repeat;
    background-size: 300% 200%;
    padding: 0;
    box-shadow: none;
    min-width: 0;
    min-height: 0;
    position: relative;
}

.piece.selected {
    outline: 4px solid #d98296;
    transform: scale(.96);
    z-index: 2;
}

.piece.done {
    outline: 2px solid rgba(100,160,110,.6);
}

.puzzle-help {
    text-align: center;
    color: var(--muted);
    font-size: 18px;
}

.success {
    color: #8b6170;
    font-size: 22px;
    min-height: 30px;
}


/* =========================
   ENVELOPE
========================= */

#envelopeScreen {
    background: #f9e8ed;
}

.envelope {
    width: min(560px,90vw);
    height: 340px;
    position: relative;
    cursor: pointer;
    margin: 30px auto 0;
    filter: drop-shadow(
        0 20px 25px rgba(90,40,60,.14)
    );
}

.env-body {
    position: absolute;
    inset: 50px 0 0;
    background: #fffaf4;
    border-radius: 10px;
    border: 1px solid #ead5da;
    overflow: hidden;
}

.env-flap {
    position: absolute;
    left: 0;
    right: 0;
    top: 50px;
    height: 220px;
    background: #f4c5cf;
    clip-path: polygon(
        0 0,
        100% 0,
        50% 62%
    );
    z-index: 5;
    transform-origin: top;
    transition: 1s;
}

.env-front {
    position: absolute;
    inset: 50px 0 0;
    z-index: 6;
    pointer-events: none;

    background:
        linear-gradient(
            145deg,
            transparent 49%,
            #f2c0cb 50%
        )
        left bottom / 50% 100% no-repeat,

        linear-gradient(
            215deg,
            transparent 49%,
            #efbbc7 50%
        )
        right bottom / 50% 100% no-repeat;
}

.seal {
    position: absolute;
    z-index: 7;
    top: 150px;
    left: 50%;
    transform: translateX(-50%);
    width: 66px;
    height: 66px;
    border-radius: 50%;
    background: #c96f82;
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 28px;
    transition: .6s;
}

.envelope.open .env-flap {
    transform: rotateX(180deg);
    z-index: 1;
}

.envelope.open .seal {
    opacity: 0;
    transform:
        translateX(-50%)
        scale(.4);
}

.letter-peek {
    position: absolute;
    left: 7%;
    right: 7%;
    top: 75px;
    height: 205px;
    background: #fffdf8;
    z-index: 3;
    border: 1px solid #eadde0;
    padding: 30px;
    text-align: center;
    transition: 1s;
}

.envelope.open .letter-peek {
    transform: translateY(-155px);
}

.letter-peek b {
    font-family: "Playfair Display", serif;
    font-size: 25px;
}


/* =========================
   LETTER
========================= */

#letter {
    background: #f3e2e6;
    align-items: flex-start;
    padding-top: 55px;
}

.notebook {
    width: min(900px,94vw);
    padding: 55px clamp(24px,6vw,75px);
    position: relative;

    background-color: #fffdf7;

    background-image:
        repeating-linear-gradient(
            to bottom,
            transparent 0,
            transparent 42px,
            rgba(100,150,190,.16) 43px,
            transparent 44px
        );

    border-radius: 5px;

    box-shadow:
        0 20px 60px rgba(70,45,50,.14);
}

.notebook:before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 54px;
    width: 2px;
    background: rgba(210,105,125,.22);
}

.notebook h2 {
    text-align: center;
    margin-bottom: 48px;
    font-family: "Kalam", cursive;
    font-weight: 400;
}

.letter-content p {
    margin: 0 0 44px;
    padding-left: 28px;
}

.letter-content .sign {
    text-align: right;
    font-family: "Kalam", cursive;
    font-size: 28px;
    margin-top: 50px;
}


/* =========================
   LOVE NOTE JAR
========================= */

#jar {
    background:
        linear-gradient(
            180deg,
            #fffaf5,
            #f7e8ec
        );
}

.jar-wrap {
    text-align: center;
}

.remaining {
    font: 600 22px "Kalam", cursive;
    color: #875d69;
    margin: 10px 0 22px;
}

.jar-visual {
    width: 210px;
    height: 280px;
    margin: 10px auto 30px;
    position: relative;

    border: 6px solid rgba(180,135,145,.45);
    border-top: 0;

    border-radius:
        28px 28px
        65px 65px;

    background:
        linear-gradient(
            90deg,
            rgba(255,255,255,.65),
            rgba(255,255,255,.18) 30%,
            rgba(255,255,255,.5)
        );

    box-shadow:
        inset 0 0 30px rgba(255,255,255,.7),
        0 22px 40px rgba(100,50,70,.13);

    overflow: hidden;
}

.jar-visual:before {
    content: "";
    position: absolute;
    width: 145px;
    height: 28px;
    top: -20px;
    left: 26px;

    border: 6px solid rgba(180,135,145,.5);
    border-radius: 12px;
    background: #e7cfd5;
}

.note-paper {
    position: absolute;
    width: 80px;
    height: 44px;

    background: #fff6b7;
    border: 1px solid #e8d98b;

    transform: rotate(var(--r));

    box-shadow:
        0 3px 8px rgba(80,50,30,.12);
}

.jar-message {
    min-height: 140px;
    max-width: 620px;
    margin: 0 auto 28px;
    padding: 28px;

    background: #fffdf8;
    border-radius: 16px;

    box-shadow:
        0 14px 35px rgba(80,50,60,.1);

    font-size: 25px;
    line-height: 1.6;

    animation: fadeUp .5s ease both;
}


/* =========================
   FINAL SCREEN
========================= */

#final {
    min-height: 100vh;
    background: #fffdf9;
    text-align: center;
    flex-direction: column;
    overflow: hidden;
}

.final-title {
    opacity: 0;
    transform: translateY(20px);

    font-family: "Playfair Display", serif;
    font-size: clamp(48px,10vw,100px);
    line-height: 1.05;
    font-weight: 500;

    margin: 0;

    animation:
        finalIn 2.6s 1s forwards;
}

.final-sub {
    opacity: 0;

    font-size:
        clamp(23px,4vw,32px);

    margin-top: 25px;

    animation:
        finalIn 2.4s 2.1s forwards;
}

@keyframes finalIn {

    to {
        opacity: 1;
        transform: none;
    }

}

.falling {
    position: absolute;
    top: -60px;
    pointer-events: none;

    animation:
        fall linear forwards;
}

@keyframes fall {

    0% {
        transform:
            translateY(-80px)
            rotate(0deg);

        opacity: 0;
    }

    10% {
        opacity: .9;
    }

    100% {
        transform:
            translateY(110vh)
            rotate(540deg);

        opacity: 0;
    }

}

.flower-corner {
    position: absolute;
    font-size: 30px;
    opacity: .65;
}

.c1 {
    left: 5%;
    top: 8%;
}

.c2 {
    right: 7%;
    top: 13%;
}

.c3 {
    left: 8%;
    bottom: 10%;
}

.c4 {
    right: 6%;
    bottom: 8%;
}

</style>
</head>


<body>


<!-- =====================================================
     1. HEART LOCK
===================================================== -->

<section id="lock" class="screen">

    <div class="paper center fade">

        <div class="lock-heart">
            <span>♡</span>
        </div>

        <h1>A little something for you</h1>

        <p class="small">
            Three little questions first…
            then the surprise begins. 🌷
        </p>

        <div id="questions"></div>

    </div>

</section>



<!-- =====================================================
     2. SONG SELECTION
===================================================== -->

<section id="songs" class="screen hidden">

    <div class="paper fade">

        <div class="center">

            <div style="font-size:48px">
                🎵
            </div>

            <h2>Choose a song</h2>

            <p class="small">
                Pick the one you want to hear while going through this. ♡
            </p>

        </div>

        <div
            class="song-list"
            id="songList">
        </div>

        <div
            class="center small"
            id="nowPlaying">
        </div>

    </div>

</section>



<!-- =====================================================
     3. BIRTHDAY INTRO
===================================================== -->

<section id="intro" class="screen hidden">

    <span class="flower-corner c1">
        🌷
    </span>

    <span class="flower-corner c2">
        ✦
    </span>

    <div class="paper intro-copy fade">

        <div class="intro-flower">
            💌
        </div>

        <h2>
            Happy Birthday, Carino ♡
        </h2>

        <p>

            I wanted to make you something that wasn't
            just a gift, but a tiny place where some of
            our memories could live.

            There are so many ordinary little moments
            that became special simply because you were there.

            So take your time, listen to the music,
            solve the little puzzle, open the letter,
            and read everything slowly.

            This is my little birthday corner for you. 🤍

        </p>

        <button onclick="showSection('memories')">
            Keep going ♡
        </button>

    </div>

</section>



<!-- =====================================================
     4. MEMORIES
===================================================== -->

<section id="memories" class="screen hidden">

    <div class="paper fade">

        <div class="center">

            <div style="font-size:42px">
                📸
            </div>

            <h2>
                The memories we share
            </h2>

            <p class="small">
                A few little pieces of the time
                we've had together.
            </p>

        </div>


        <div class="mem-grid">

            <div class="mem">

                <img
                    src="2a9c0291-d66a-46a7-bd40-6d751050d81c.JPG"
                    alt="Memory 1">

                <div class="mem-caption">
                    one of my favourite little moments ♡
                </div>

            </div>


            <div class="mem">

                <img
                    src="IMG_6830.jpg"
                    alt="Memory 2">

                <div class="mem-caption">
                    another memory I want to keep
                </div>

            </div>


            <div class="mem">

                <img
                    src="3F4401DF-DBB8-4E14-A1D9-EA782CFC29D6.jpeg"
                    alt="Memory 3">

                <div class="mem-caption">
                    us, in a moment worth remembering
                </div>

            </div>

        </div>


        <div
            class="center"
            style="margin-top:42px">

            <button onclick="showSection('puzzle')">

                There's one more thing… 🌹

            </button>

        </div>

    </div>

</section>



<!-- =====================================================
     5. ROSE PUZZLE
===================================================== -->

<section id="puzzle" class="screen hidden">

    <div class="paper fade">

        <div class="center">

            <div style="font-size:42px">
                🧩🌹
            </div>

            <h2>
                A little rose puzzle
            </h2>

            <p class="puzzle-help">

                Tap two pieces to swap them.
                Put all six back in the right places.

            </p>

        </div>


        <div class="puzzle-wrap">

            <div
                id="puzzleBoard"
                class="puzzle">
            </div>

        </div>


        <div class="center">

            <div
                id="puzzleStatus"
                class="success">
            </div>

            <button
                id="puzzleNext"
                class="hidden"
                onclick="showSection('envelopeScreen')">

                You solved it 💗

            </button>

        </div>

    </div>

</section>



<!-- =====================================================
     6. ENVELOPE
===================================================== -->

<section
    id="envelopeScreen"
    class="screen hidden">

    <div class="paper center fade">

        <div style="font-size:42px">
            ✉️
        </div>

        <h2>
            Something is waiting for you
        </h2>

        <p class="small">
            Click the envelope.
        </p>


        <div
            id="envelope"
            class="envelope"
            onclick="openEnvelope()">


            <div class="env-body">
            </div>


            <div class="letter-peek">

                <b>
                    A little note for you…
                </b>

                <br>

                <span
                    style="
                    font-size:18px;
                    color:#866d76;
                    ">

                    open me ♡

                </span>

            </div>


            <div class="env-flap">
            </div>


            <div class="env-front">
            </div>


            <div class="seal">
                ♡
            </div>

        </div>

    </div>

</section>



<!-- =====================================================
     7. HEARTFELT LETTER
===================================================== -->

<section id="letter" class="screen hidden">

    <div class="notebook fade">

        <h2>
            A Little Note for You ♡
        </h2>


        <div class="letter-content">


            <p>

                Carino, I don't even know where to start
                because there are so many little memories
                of us that still make me smile.

                When I think about the time we've spent
                together, it's not only the big moments
                I remember.

                It's all the ordinary things that somehow
                became special because we were doing them
                together.

            </p>


            <p>

                I remember spending time together with
                your family and my brothers, watching
                movies together and just being around
                each other.

                Those movie nights might sound simple,
                but they're the kind of memories that stay
                in my head for no reason at all —
                probably because they felt comfortable,
                happy and ours.

            </p>


            <p>

                And then there were all those nights when
                we somehow kept talking and talking until
                2 or 3 in the morning.

                We would start with one thing and suddenly
                hours had disappeared.

                I don't know how we managed to stay awake
                like that, but honestly, I loved those
                late-night conversations. 🌙

            </p>


            <p>

                I also love remembering us cooking together.

                You never really let me do much work anyway. 😭

                You would be busy cooking while I was
                mostly watching you and taking videos of you —

                because apparently one of my favourite hobbies
                is just recording you doing completely normal
                things.

                And I still love those videos because they
                hold tiny moments that I never want to forget.

            </p>


            <p>

                And the evenings when we sang songs together…

                I adore those memories.

                Especially you singing for me.

                Even if I've heard the same song a million
                times, I would still want to hear you sing
                it again.

                There is just something about hearing a song
                from you that makes it feel different. 🎶

            </p>


            <p>

                And I can never forget the flowers.

                Whenever we went somewhere and you saw flowers,
                you would pick one and give it to me.

                And when you found those tiny sunflower-like
                flowers, you would pick six or seven and make
                a little bouquet.

                It was such a small thing, but it made me
                ridiculously happy. 🌻

            </p>


            <p>

                But the first bouquet you gave me will always
                have a special place in my heart.

                It was the first bouquet —
                the first flowers I received from you —
                and it was so beautiful.

                The yellow flowers, the purple flowers,
                the pink rose and the hibiscus…

                I remember all of it. 💐

            </p>


            <p>

                You used to be there for me whenever I needed
                you, except for those times when you were busy,
                of course.

                And I want you to know that I remember that too.

                I remember the comfort of knowing that I could
                have you there, and I remember the little ways
                you showed that you cared.

            </p>


            <p>

                There is also one extremely serious unfinished
                business between us:

                my cheesecake. 😭

                I asked you for a cheesecake for four whole
                months and somehow I am STILL waiting.

                At this point, the cheesecake has become a
                historical event.

                But yes, despite this terrible betrayal,
                I still care about you and adore you.

                So congratulations, I guess. 😂🍰

            </p>


            <p>

                No matter who you become, or how much you change,
                I think a part of me will always care about you
                and adore the person you are.

                I don't know what every future version of life
                will look like, but I know that the memories
                we've made have a special little place in my heart.

            </p>


            <p>

                So on your birthday, I just want you to know
                that you are loved, you are cared for, and you
                matter to me more than a simple birthday message
                could ever explain.

                Thank you for all the little moments, the laughs,
                the late nights, the songs, the flowers, the
                movies, the cooking, and everything in between.

            </p>


            <p>

                Happy birthday, Carino. ♡

                I hope this year gives you reasons to smile,
                reasons to feel proud of yourself, and a lot
                of beautiful moments to remember.

            </p>


            <p class="sign">

                With love,<br>

                the person STILL waiting
                for her cheesecake. 😭🤍

            </p>


        </div>


        <div
            class="center"
            style="margin-top:60px">

            <button onclick="showSection('jar')">

                One last little thing… 🫙

            </button>

        </div>

    </div>

</section>



<!-- =====================================================
     8. JAR OF 10 LOVE NOTES
===================================================== -->

<section id="jar" class="screen hidden">

    <div class="paper jar-wrap fade">

        <div style="font-size:45px">
            🫙💗
        </div>

        <h2>
            A jar of little thoughts
        </h2>

        <p class="small">

            There are 10 little notes inside.
            Each one appears only once.

        </p>


        <div
            id="remaining"
            class="remaining">

            10 notes remaining

        </div>


        <div
            id="jarVisual"
            class="jar-visual">

        </div>


        <div
            id="jarMessage"
            class="jar-message hidden">
        </div>


        <button
            id="jarButton"
            onclick="openNote()">

            Take a little note ♡

        </button>


        <div
            id="jarDone"
            class="hidden"
            style="margin-top:22px">

            <p>
                That's all 10. 🤍
            </p>

            <button onclick="showSection('final')">

                Finish the little surprise ✨

            </button>

        </div>

    </div>

</section>



<!-- =====================================================
     9. FINAL BIRTHDAY SCREEN
===================================================== -->

<section id="final" class="screen hidden">

    <div id="fallingLayer">
    </div>


    <div class="flower-corner c1">
        🌸
    </div>

    <div class="flower-corner c2">
        ✦
    </div>

    <div class="flower-corner c3">
        🍃
    </div>

    <div class="flower-corner c4">
        🌷
    </div>


    <h1 class="final-title">

        Happy Birthday, Carino

    </h1>


    <p class="final-sub">

        You are loved more than you imagine.

    </p>

</section>



<!-- =====================================================
     AUDIO
===================================================== -->

<audio
    id="audioPlayer"
    preload="auto">
</audio>



<script>


/* =====================================================
   SONGS
===================================================== */

const SONGS = [

    {
        title: "I Thought I Saw Your Face Today",
        artist: "She & Him",
        file: "AUDIO-2026-09-05-14-00-58.mp3"
    },

    {
        title: "The Way I Loved You",
        artist: "Taylor Swift",
        file: "AUDIO-2026-09-05-14-01-16(1).mp3"
    },

    {
        title: "Can't Help Falling in Love",
        artist: "Elvis Presley",
        file: "AUDIO-2026-09-05-14-01-33.mp3"
    }

];



/* =====================================================
   LOVE NOTES
===================================================== */

const NOTES = [

    "You make ordinary moments feel like little memories I want to keep forever. ♡",

    "I still remember the tiny flowers you used to pick for me. They meant more than you probably knew. 🌼",

    "Even after hearing the same song a million times, I could still listen to you sing it again. 🎶",

    "Some of my favourite memories are the quiet ones — late talks, random laughs, and just being together. 🌙",

    "You are one of those people who left little pieces of happiness in my memories. 🤍",

    "I love the way you used to turn a few tiny flowers into the cutest little bouquet. 🌻",

    "Movie nights, cooking together, singing in the evening… I would replay those days if I could. 🎬",

    "No matter who you become, I hope you always know that you mattered to me deeply. ♡",

    "I still adore the memory of that first bouquet — yellow, purple, pink and hibiscus. 💐",

    "And yes… I am STILL waiting for that cheesecake. Four months and counting. 😭🍰"

];



/* =====================================================
   GENERAL
===================================================== */

const sections = [

    "lock",
    "songs",
    "intro",
    "memories",
    "puzzle",
    "envelopeScreen",
    "letter",
    "jar",
    "final"

];


let currentSong = null;

let selectedPuzzle = null;

let puzzleOrder = [];

let notePool = [...NOTES];



/* =====================================================
   LOCK QUESTIONS
===================================================== */

const questions = [

    [
        "What nickname do I call you? ♡",
        "carino"
    ],

    [
        "When is our anniversary? 🌷",
        "23 january"
    ],

    [
        "What's my favourite flower? 🌸",
        "lily"
    ]

];



function buildQuestions() {

    const box =
        document.getElementById("questions");

    box.innerHTML = "";

    questions.forEach((q, i) => {

        const div =
            document.createElement("div");

        div.className =
            "question" +
            (i ? " hidden" : "");

        div.id =
            "q" + i;


        div.innerHTML = `

            <p>

                <b>${i + 1}.</b>
                ${q[0]}

            </p>

            <input
                id="ans${i}"
                autocomplete="off"
                autocapitalize="none"
                spellcheck="false"
                placeholder="Type your answer…"
            >

            <div
                id="err${i}"
                class="error">
            </div>

            <button
                onclick="checkQuestion(${i})">

                Unlock ♡

            </button>

        `;

        box.appendChild(div);

    });

}



function normalize(value) {

    return value
        .trim()
        .toLowerCase()
        .replace(/\s+/g, " ");

}



function checkQuestion(i) {

    const input =
        document.getElementById(
            "ans" + i
        );

    const error =
        document.getElementById(
            "err" + i
        );


    if (
        normalize(input.value) ===
        normalize(questions[i][1])
    ) {

        if (i < questions.length - 1) {

            document
                .getElementById("q" + i)
                .classList
                .add("hidden");

            document
                .getElementById("q" + (i + 1))
                .classList
                .remove("hidden");

        }

        else {

            showSection("songs");

            buildSongs();

        }

    }

    else {

        error.textContent =
            "Hmm… try again, birthday boy. ♡";

        input.focus();

    }

}



/* =====================================================
   SECTION NAVIGATION
===================================================== */

function showSection(id) {

    sections.forEach(section => {

        document
            .getElementById(section)
            .classList
            .add("hidden");

    });


    document
        .getElementById(id)
        .classList
        .remove("hidden");


    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });


    if (id === "puzzle") {

        initPuzzle();

    }


    if (id === "jar") {

        buildJar();

    }


    if (id === "final") {

        startFalling();

    }

}



/* =====================================================
   SONG SELECTION
===================================================== */

function buildSongs() {

    const list =
        document.getElementById(
            "songList"
        );


    if (list.children.length) {

        return;

    }


    SONGS.forEach((song, index) => {

        const element =
            document.createElement("div");


        element.className =
            "song";


        element.innerHTML = `

            <div class="disc">
            </div>

            <div>

                <b>
                    ${song.title}
                </b>

                <span>
                    ${song.artist}
                </span>

            </div>

        `;


        element.onclick = () =>
            selectSong(index);


        list.appendChild(element);

    });

}



function selectSong(index) {

    const song =
        SONGS[index];


    const audio =
        document.getElementById(
            "audioPlayer"
        );


    currentSong = index;


    audio.src =
        song.file;


    audio.currentTime = 0;


    audio.play().catch(() => {});


    document.getElementById(
        "nowPlaying"
    ).textContent =
        "♪ Now playing: " +
        song.title +
        " — " +
        song.artist;


    setTimeout(() => {

        showSection("intro");

    }, 500);

}



/* =====================================================
   PUZZLE
===================================================== */

function initPuzzle() {

    if (puzzleOrder.length) {

        return;

    }


    puzzleOrder = [
        0, 1, 2,
        3, 4, 5
    ];


    do {

        puzzleOrder.sort(
            () => Math.random() - .5
        );

    }

    while (
        puzzleOrder.every(
            (value, index) =>
                value === index
        )
    );


    renderPuzzle();

}



function renderPuzzle() {

    const board =
        document.getElementById(
            "puzzleBoard"
        );


    board.innerHTML = "";


    puzzleOrder.forEach(
        (pieceIndex, slot) => {

            const button =
                document.createElement(
                    "button"
                );


            button.className =
                "piece" +
                (
                    selectedPuzzle === slot
                    ? " selected"
                    : ""
                );


            const column =
                pieceIndex % 3;


            const row =
                Math.floor(
                    pieceIndex / 3
                );


            button.style.backgroundImage =
                "url('45B4C78E-F6F0-4160-8CBE-3E776BBA2E0C.jpeg')";


            button.style.backgroundPosition =
                `${column * 50}% ${row * 100}%`;


            button.onclick =
                () => pickPiece(slot);


            board.appendChild(button);

        }
    );

}



function pickPiece(slot) {

    if (
        selectedPuzzle === null
    ) {

        selectedPuzzle = slot;

        renderPuzzle();

        return;

    }


    if (
        selectedPuzzle === slot
    ) {

        selectedPuzzle = null;

        renderPuzzle();

        return;

    }


    [
        puzzleOrder[selectedPuzzle],
        puzzleOrder[slot]

    ] = [

        puzzleOrder[slot],
        puzzleOrder[selectedPuzzle]

    ];


    selectedPuzzle = null;


    renderPuzzle();


    if (
        puzzleOrder.every(
            (value, index) =>
                value === index
        )
    ) {

        document
            .getElementById(
                "puzzleStatus"
            )
            .textContent =
            "You put the rose back together. 🌹";


        document
            .getElementById(
                "puzzleNext"
            )
            .classList
            .remove("hidden");


        document
            .querySelectorAll(".piece")
            .forEach(piece => {

                piece.classList.add("done");

            });

    }

}



/* =====================================================
   ENVELOPE
===================================================== */

function openEnvelope() {

    const envelope =
        document.getElementById(
            "envelope"
        );


    if (
        envelope.classList.contains(
            "open"
        )
    ) {

        return;

    }


    envelope
        .classList
        .add("open");


    setTimeout(() => {

        showSection("letter");

    }, 1300);

}



/* =====================================================
   LOVE NOTE JAR
===================================================== */

function buildJar() {

    const jar =
        document.getElementById(
            "jarVisual"
        );


    jar.innerHTML = "";


    for (
        let i = 0;
        i < 10;
        i++
    ) {

        const note =
            document.createElement(
                "div"
            );


        note.className =
            "note-paper";


        note.style.left =
            (18 + Math.random() * 105)
            + "px";


        note.style.top =
            (95 + Math.random() * 145)
            + "px";


        note.style.setProperty(
            "--r",
            (Math.random() * 36 - 18)
            + "deg"
        );


        jar.appendChild(note);

    }


    document.getElementById(
        "remaining"
    ).textContent =
        notePool.length +
        " notes remaining";

}



function openNote() {

    if (notePool.length === 0) {

        return;

    }


    const randomIndex =
        Math.floor(
            Math.random() *
            notePool.length
        );


    const note =
        notePool.splice(
            randomIndex,
            1
        )[0];


    const message =
        document.getElementById(
            "jarMessage"
        );


    message.classList
        .remove("hidden");


    message.textContent =
        note;


    message.classList
        .remove("fade");


    void message.offsetWidth;


    message.classList
        .add("fade");


    document.getElementById(
        "remaining"
    ).textContent =
        notePool.length +
        " notes remaining";


    if (
        notePool.length === 0
    ) {

        document.getElementById(
            "jarButton"
        ).classList
        .add("hidden");


        document.getElementById(
            "jarDone"
        ).classList
        .remove("hidden");

    }

}



/* =====================================================
   FINAL FALLING FLOWERS
===================================================== */

function startFalling() {

    const layer =
        document.getElementById(
            "fallingLayer"
        );


    if (
        layer.dataset.started
    ) {

        return;

    }


    layer.dataset.started = "1";


    const symbols = [

        "🌸",
        "🌷",
        "🌼",
        "🍃",
        "✦",
        "♡",
        "❀"

    ];


    for (
        let i = 0;
        i < 45;
        i++
    ) {

        const element =
            document.createElement(
                "div"
            );


        element.className =
            "falling";


        element.textContent =
            symbols[
                Math.floor(
                    Math.random() *
                    symbols.length
                )
            ];


        element.style.left =
            Math.random() * 100 +
            "vw";


        element.style.fontSize =
            14 +
            Math.random() * 22 +
            "px";


        element.style.animationDuration =
            6 +
            Math.random() * 8 +
            "s";


        element.style.animationDelay =
            Math.random() * 8 +
            "s";


        layer.appendChild(
            element
        );

    }

}



/* =====================================================
   START
===================================================== */

buildQuestions();

</script>

</body>
</html>